# LYNXgwas Server settings. Copy to server.properties (next to the launcher) and edit.
# The one secret (the pepper) is NOT stored here: it is read from the environment variable named below.
# No email server is needed: visitors use anonymous workspaces (no email, no password).

# ── Network ─────────────────────────────────────────────────────────────
# Keep 127.0.0.1 and put a TLS reverse proxy (Caddy, nginx) in front: see deploy/Caddyfile.
bind.host=127.0.0.1
port=8765
# The address people type in their browser. Used for CSRF origin checks and in workspace links.
public.origin=https://lynxgwas.example.org
# true when served over HTTPS (always, in production): Secure cookies + HSTS.
secure.cookies=true
# true only when the proxy in front is yours (X-Forwarded-For is then trusted for rate limits).
trust.proxy=true

# ── Storage ─────────────────────────────────────────────────────────────
# Private server state: workspaces (token digests only), project ownership, secret key.
# Absolute path recommended; must NOT be inside a web-served folder. Back it up.
data.dir=/srv/lynxgwas/server-data
# Project folders are always <app>/projects; make that a symlink to your data disk if needed.
# Public, read-only datasets: comma-separated project ids, or * for every project without an owner.
public.projects=*

# ── Reference data (every user project uses these; users cannot choose paths) ──
ref.panel.path=/srv/lynxgwas/ref/eur_1000g_dedup2
ref.panel.population=EUR
gff3.file=/srv/lynxgwas/ref/gencode.v37lift37.annotation.gff3
# Optional: SuSiEx.py for cross-ancestry fine-mapping (empty = feature disabled)
susiex.path=

# ── Retention and quotas ─────────────────────────────────────────────────
# User projects are deleted this many days after creation (the page shows a countdown).
retention.days=15
# A workspace nobody has opened for this many days is removed (must be >= retention.days).
workspace.idle.days=30
max.upload.mb=2048
max.projects.per.user=5
max.storage.per.user.mb=8192
# All user projects together; uploads are refused when full (0 = no limit, not recommended).
max.storage.total.mb=150000
# Anonymous workspaces one IP address may create per hour (stops scripts creating thousands).
max.new.workspaces.per.ip.per.hour=10
# Heavy jobs (processing, analyses) running at once: per workspace, and for the whole server.
max.jobs.per.user=1
max.jobs.total=4

# ── Secret key ───────────────────────────────────────────────────────────
# Environment variable with a random secret (at least 32 characters) used to protect the stored
# workspace token digests. If unset, a random key is generated once into <data.dir>/pepper.key.
# Changing it disconnects every workspace from its browsers and links.
pepper.env=LYNX_CODE_PEPPER
