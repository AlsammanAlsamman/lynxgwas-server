# Copy to .env (never commit .env) and edit. Used by docker-compose.yml.

# Host folder with the reference data, mounted read-only at /reference in the container.
# Expected layout (names must match docker/server.docker.properties):
#   gencode.v37lift37.annotation.gff3
#   panel/g1000_eur.{bed,bim,fam}  and, for ~4x faster loci identification, panel/g1000_eur_chr1..22.*
#   ldsc/eur_w_ld_chr/             (SNP-heritability)
#   cadd/gnomad.genomes.r2.1.1.snv.tsv.gz + .tbi   (optional, causal-SNP ranking)
LYNXGWAS_REFERENCE_DIR=/srv/lynxgwas/reference

# Public domain name (only for the Caddy HTTPS profile)
LYNXGWAS_DOMAIN=lynxgwas.example.org

# The one secret (no email server or passwords are used). Random, at least 32 characters:
#   head -c 48 /dev/urandom | base64
LYNX_CODE_PEPPER=

# Resource limits for the container (load test: 16 CPUs / 32 GB machine recommended)
LYNXGWAS_CPUS=8
LYNXGWAS_MEMORY=24g
JAVA_OPTS=-Xmx6g
LYNXGWAS_TMP_SIZE=4g
LYNXGWAS_PLINK_BUDGET_MB=8000
# Host port on 127.0.0.1
LYNXGWAS_PORT=8765
